<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
       
	<servlet>
	<servlet-name>BankingApp</servlet-name>
	<servlet-class>nikhil.controller.ShowBalanceApp</servlet-class>
	<security-role-ref>
		<!-- logical name-->
		<role-name>nikhil</role-name>
		<!-- actual rolename-->
		<role-link>nikhilrole</role-link>
	</security-role-ref>
	</servlet> 
	
	<servlet-mapping>
		<servlet-name>BankingApp</servlet-name>
		<url-pattern>/showBalance</url-pattern>
	</servlet-mapping>
    <security-constraint>
    	<web-resource-collection>
    		<web-resource-name>SHOWBALANCE</web-resource-name>
    		<url-pattern>/showBalance</url-pattern>
    		<http-method>POST</http-method>
    		<http-method>GET</http-method>
    	</web-resource-collection>
    	
    	<auth-constraint>
    		<role-name>nikhilrole</role-name>
    		<role-name>adminrole</role-name>
    	</auth-constraint>
    </security-constraint> 
    
    <login-config>
    	<auth-method>FORM</auth-method>
    	<form-login-config>
    	<form-login-page>/login_form.html</form-login-page>
    	<form-error-page>/login_failed.html</form-error-page>
    	</form-login-config>
    </login-config> 
    
    <security-role>
    	<role-name>nikhilrole</role-name>
    </security-role> 
    <security-role>
    	<role-name>adminrole</role-name>
    </security-role> 
    
    <error-page>
    	<error-code>403</error-code>
    	<location>/403_error.jsp</location>
    </error-page>  
          
</web-app>